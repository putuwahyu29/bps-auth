<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.result.cache">
    <testsuites>
        <testsuite name="BPS SSO Test Suite">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:MTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTE="/>
        <env name="BPS_SSO_KEYCLOAK_URL" value="https://accounts.bps.go.id"/>
        <env name="BPS_SSO_REALM" value="pegawai"/>
        <env name="BPS_SSO_CLIENT_ID" value="test-client"/>
        <env name="BPS_SSO_CLIENT_SECRET" value="test-secret"/>
    </php>
</phpunit>
